generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("Pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id        String   @id // Will match Supabase Auth user ID (UUID)
  email     String   @unique
  role      String   @default("Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model Project {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  content     String
  imageUrl    String
  tags        String[]
  features    String[]
  githubUrl   String?
  liveUrl     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certificate {
  id            String   @id @default(uuid())
  title         String
  issuer        String
  issueDate     String
  credentialUrl String?
  imageUrl      String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoginAttempt {
  ip        String    @id
  attempts  Int       @default(1)
  blockedAt DateTime?
  updatedAt DateTime  @updatedAt
}



